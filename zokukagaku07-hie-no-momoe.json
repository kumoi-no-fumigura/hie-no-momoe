 "poems": [
  {
   "seq": "1",
   "text": "おやぞらお高く貴とき日枝の嶺い今のみやこの天のかぐ山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "かゝる山北ありつれどあそ君グ代の平安城い造りましけめ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "君ませバ山のうしろを改さめて日枝もかもてに成になる哉",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "此みやこひらけをなへぞ唐土に聞えし山いおほひえのやま",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "斧とりて祝ひ初けん一ふしぞ我たつそまのみやばしらなる",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "二國の堺にたてるたまがきいひえの杉もてゆへるなりけり",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "大ひえの山高けれどむろしよりもゆるおもひの烟やいさつ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "四比絃の海邊にそひて日枝の山裾ハ長柄ふひきなせるかな",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "から人も一夜ふしみの朝とでにあふぎみるてふひえの遠山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "近江にいかゞみの山もたちたれどあふぎみらるゝ山い此山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いく藥とるべかりけり大ひえい近江あうクぶ龜北うへの山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あたごにハ雪いかくれてみえしかど春まづ霞む日枝の大岳",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "大ひえのゆきの山窓いつのまに春ゑる梅おひらけそめけむ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "〓やこにい明日やいづらん黑谷のふるすなおらの鶯比こゑ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "大日校せやまの心も動くらしひらも長柄もはなさたにけり",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "よもにみる花比匂ひをいかゞせんこの大たけの春の明ばの",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "花つみにむれつゝ人の昇る哉山ほとゝ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "分々登るあみだが峯のほとゝぎも十聲までとも賴まるゝ哉",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "我外に誰とふらんと思ひしい飯むろをたゝく水雞なりけり",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "うしとらの峯に雲あそかゝりけれ今日もたのはじ夕立の雨",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "雨たべと願ヘバ日枝の雲おりて心おまかす賀茂のかいみコ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "千とせふるひえの杉むら〓〓くれが夏さへ寒しひえの杉村",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "花ならでかぐはしき哉ひえの山神さびたてるすぎの下ろぜ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "大日枝の高ねの小ざさをりしきて鳰の海てる月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "ながむれが心のうちに入りにりりひえの高ねの秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "千年へむ是もくすり生玉なれやひえの出路のきくの白つゆ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "秋の色も殊あしありけり大日枝い鹿比苑とや紅葉しぬらむ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "大ひえの山比奥あも鳴く鹿の妻あふる道ぞもべなかりける",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "山めぐる時雨比雲Hひくけれが空おぞひえの峯い晴れたる",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "むら杉のひまもる月も氷る夜の橫川のほらにましらなくん",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "大ひえにいつくたから北塔よりや霰比玉の〓だれていふる",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "大ひえの山お我子代ありもせバいかふおおめむ今朝の初雪",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "大ひえに大雪ふれり打つけにふじとや",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "此山い鬼ゐる門をふたぐれい年もくれぞやあらんとすらむ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "大ひえいろしこうり々り麓なるやせの汐湯やあみて登らむ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "大ひえの西坂本の雪のうちになりけん梅のあともたづねん",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "ましらなくひに比山路をわけてこそ柿の葉草の種も得にけれ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "昔みし誰をらなくにあかねさす日枝の山百合なつかしき哉",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "此山に立つあれを〓の只一木もとのねざしを知る由ぞおた",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "大ひえの谷にみえつる玄ら蛇い今もすめるク岩のはざまに",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "山の名比驚やかけるとうちみれバ小ざさを渡る嵐なりりと",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "わけのぼる山路苦しも慈悲心と鳴てともずふ鳥の音もがお",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "水上にゆゑあそあらめ日枝の山音羽の瀧い瑠瑪をくだせり",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "日枝にきてるり北光になたる身いかしらの色も若ゆべき哉",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "今朝こそい都とでしか靈山の釋迦のみ前にいつか來にけむ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "石橋とかゝれるひえの雲の上に文珠の御か",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "天降さる石もたゞぞゑ唐土の土をふませし獅子も立つめり",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "大君はらゝげましける盤火も子とせ經ぬらしいえの山でら",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "大口のまがふも人に仇せぬいくもしきひえH山クらならし",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "高つ鳥こだまも法のおはすいめおそりいならじひえの奧山",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "道に入るこゝろやつけし日枝の神歸る家路を思はざどろり",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "近江の海八十の湊を一目おいひにの高ねにしりてこそそれ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "大ひえお日かどまつまの朝おらけはるかに匂ふふじの白雪",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "此山の千とせや種とこぼれ落ちてひともと茂るから崎の松",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "大嶽のもい吹く風にくも晴れておものゝ濱北遠じるくみゆ",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "この峰孔霧もはれたる朝なぎにやばせあぐ船うら安げなる",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "大ひえに遊びてみれど四の絃のことぢなりなり瀨田比長橋",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "おほたけいまだくれなくに白雲の底よりひゞく三井寺比鐘",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "大岳のくもの上おて歴おつる堅田のうらを今日見つるかな",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "こも枕たかせのよともかつとえて夢かとを思ふひえの大岳",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "ひえお來て我すむ里を打みれバまつ毛比塵比世ふあそ有りれ",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "後の世にきくものしこしともすれバ榊をおろすひえの山風",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "墨染のそであふさはぬ劔太刀山のおもてもふせつべらなり",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "ひえ颪雲のとばりを吹きまきてあらぬみ顏のそえし其よい",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "臣比みちたれふかはらむ雲母坂よしや草葉のつゆの碎けい",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "軍人たてしりぶりいうありけん比えも淺間の山とみるまで",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さのしミも深き山路をこと道あ心クらひくなげきおるらむ",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "大ひえの山のやま人山分々て山ふとし經るやまのいもほる",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "日ふつぶを雨ふひらくるひえ権等こゝろい安き山路むりる〓",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "心ありて雲のとづるととゆるの形都をのぞむひえの山まど",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "坂本ふいつうゑそめて夢の世比めさまし草いおひ繁るらむ",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "是やこの千代の坂本水上になれるくすりをとらむとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "ひえ越て志賀の都にきたれどもむりしの人いあいぬ也けり",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "大ひえの山もゆすりて唐崎あみふねきはへる神まつりかお",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "八千矛北神のみけしと波母山あいつゝ代色の雲も立つらし",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "久方のあもり來ましてはも山の小ひえをくに比とこ立北神",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "忍穂耳比〓づまり居ますひえに來て天の眞名井の心をぞ汲む",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "みこし路の雪の白山ゆきりひてひえお樂しむまらうど北宮",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "大ひえに之づまりますり八の王子八隅〓らせる大君のさめ",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "國狹槌さあえますらし大ひえや小ひえの杉せ常磐のきはお",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "皇孫のくざりてませバあうねさすひえもさならら高ちほの峰",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "松の尾のまつの二葉の契あれやおほ山くひもいますこの山",
   "kana": "",
   "speaker": "",
   "page": 75,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "此山のひらくやいつと釣のいとの永くまちりん白ひルの神",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "比りの船守りきまして山お名のああき心をみせしこのかミ",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "宇佐比神あづ々ましろる衣あそい我さつそま北錦おりりも",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "宇佐の神かづりしきぬの紫や山おゆるせるはじめなるらむ",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "霞さつひえのなら坂ゆうしきおこぼれて匂ふ北のふぢむ〓",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "なら坂いその名のよひて紫ふ神比ことばのはなもさたけり",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "比りの花のく咲匂ふもとつ木の百枝の神のむうしをぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "大ひえの法の雫を乳房にておほしたつるいいくらなるちむ",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "榊にいあらぬうておの竹のよもいく世の霜あ重ねきぬらむ",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "いまもその竹生島にや遊ぶらん雲にのりてしひえ北やま人",
   "kana": "",
   "speaker": "",
   "page": 76,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
