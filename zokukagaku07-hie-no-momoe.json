 "poems": [
  {
   "seq": "1",
   "text": "おやぞらお高く貴とき日枝の嶺い今のみやこの天のかぐ山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "かゝる山北ありつれどあそ君グ代の平安城い造りましけめ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "君ませバ山のうしろを改さめて日枝もかもてに成になる哉",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "此みやこひらけをなへぞ唐土に聞えし山いおほひえのやま",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "斧とりて祝ひ初けん一ふしぞ我たつそまのみやばしらなる",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "二國の堺にたてるたまがきいひえの杉もてゆへるなりけり",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "大ひえの山高けれどむろしよりもゆるおもひの烟やいさつ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "四比絃の海邊にそひて日枝の山裾ハ長柄ふひきなせるかな",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "から人も一夜ふしみの朝とでにあふぎみるてふひえの遠山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "近江にいかゞみの山もたちたれどあふぎみらるゝ山い此山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いく藥とるべかりけり大ひえい近江あうクぶ龜北うへの山",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あたごにハ雪いかくれてみえしかど春まづ霞む日枝の大岳",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "大ひえのゆきの山窓いつのまに春ゑる梅おひらけそめけむ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "〓やこにい明日やいづらん黑谷のふるすなおらの鶯比こゑ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "大日校せやまの心も動くらしひらも長柄もはなさたにけり",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993385",
   "form": "短歌",
   "genre": ""
  },
  {
